generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationType {
  BAND
  MINISTRY
  ACOUSTIC_GROUP
  ORCHESTRA
  OTHER
}

enum MembershipRole {
  OWNER
  ADMIN
  LEADER
  MUSICIAN
  GUEST
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
  DECLINED
}

enum SongStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum EventStatus {
  CONFIRMED
  PENDING
  DRAFT
  CANCELLED
  FINISHED
}

enum AttendanceStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum FileType {
  PDF
  LYRICS
  SHEET_MUSIC
  AUDIO
  VIDEO
  BACKING_TRACK
  DOCUMENT
  IMAGE
  OTHER
}

enum SongTrackType {
  FULL_TRACK
  BACKING_TRACK
  CLICK
  PAD
  DRUMS
  BASS
  GUITAR
  KEYS
  VOCALS
  CHOIR
  GUIDE
  REFERENCE
  OTHER
}

enum TrackProvider {
  UPLOAD
  EXTERNAL_URL
  LOCAL
  S3
  R2
  SUPABASE
  OTHER
}

enum SongLinkProvider {
  YOUTUBE
  SPOTIFY
  APPLE_MUSIC
  SOUNDCLOUD
  VIMEO
  BANDCAMP
  WEBSITE
  OTHER
}

enum SongFileCategory {
  LYRIC_PDF
  CHORD_CHART
  SHEET_MUSIC
  LEAD_SHEET
  PIANO_SCORE
  GUITAR_SCORE
  BASS_SCORE
  DRUM_SCORE
  VOCAL_SCORE
  IMAGE
  DOCUMENT
  PRESENTATION
  MIDI
  MUSIC_XML
  // Categorias legacy: nuevos SongFile no deberian usarlas (el audio musical
  // reproducible pertenece a SongTrack), pero se conservan por compatibilidad
  // con filas existentes.
  AUDIO
  STEM
  BACKING_TRACK
  VIDEO
  OTHER
}

enum SongNoteVisibility {
  PRIVATE
  ORGANIZATION
  LEADERS_ONLY
}

enum SongCommentTarget {
  SONG
  VERSION
  SECTION
  TRACK
  FILE
  LINK
}

enum SongThreadStatus {
  OPEN
  RESOLVED
}

enum SongActivityType {
  SONG_CREATED
  SONG_UPDATED
  SONG_ARCHIVED
  FAVORITE_CHANGED

  VERSION_CREATED
  VERSION_UPDATED
  VERSION_DELETED
  VERSION_SET_DEFAULT
  VERSION_TRANSPOSED
  VERSION_RESTORED

  TRACK_ADDED
  TRACK_UPDATED
  TRACK_DELETED
  TRACK_SET_PRIMARY

  LINK_ADDED
  LINK_UPDATED
  LINK_DELETED
  LINK_SET_PRIMARY

  FILE_ADDED
  FILE_UPDATED
  FILE_DELETED
  FILE_SET_PRIMARY

  NOTE_CREATED
  NOTE_UPDATED
  NOTE_ARCHIVED
  NOTE_DELETED
  NOTE_PINNED

  THREAD_CREATED
  THREAD_RESOLVED
  THREAD_REOPENED
  COMMENT_ADDED
}

enum SongEntityType {
  SONG
  VERSION
  TRACK
  LINK
  FILE
  NOTE
  THREAD
  COMMENT
}

enum RevisionSource {
  MANUAL_SAVE
  TRANSPOSE
  RESTORE
  IMPORT
  MIGRATION
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  passwordHash  String
  phone         String?
  avatarUrl     String?
  active        Boolean      @default(true)
  memberships   Membership[]
  invitations   Invitation[] @relation("InvitationInviter")
  uploadedFiles File[]       @relation("FileUploader")
  uploadedTracks SongTrack[] @relation("TrackUploader")
  createdSongLinks SongLink[] @relation("SongLinkCreator")
  songNotes     SongNote[]
  createdSongThreads  SongCommentThread[] @relation("SongThreadCreator")
  resolvedSongThreads SongCommentThread[] @relation("SongThreadResolver")
  songComments        SongComment[]       @relation("SongCommentAuthor")
  songCommentMentions SongCommentMention[] @relation("SongCommentMentioned")
  songActivities      SongActivity[]
  songVersionRevisions SongVersionRevision[]
  createdSetlists     Setlist[]           @relation("SetlistCreatedBy")
  updatedSetlists     Setlist[]           @relation("SetlistUpdatedBy")
  addedSetlistParticipants  SetlistParticipant[] @relation("SetlistParticipantAddedBy")
  createdSetlistAssignments SetlistAssignment[]  @relation("SetlistAssignmentCreatedBy")
  createdSetlistCues        SetlistCue[]         @relation("SetlistCueCreatedBy")
  completedSetlistCues      SetlistCue[]         @relation("SetlistCueCompletedBy")
  instruments               UserInstrument[]
  refreshTokens             RefreshToken[]
  archivedOrganizations     Organization[]       @relation("OrganizationArchiver")
  /// Organizacion activa guardada en la cuenta (sirve en cualquier dispositivo). Si se borra la organizacion queda vacia.
  activeOrganizationId      String?
  activeOrganization        Organization?        @relation("UserActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  notifications             Notification[]
  unavailability            Unavailability[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([email])
}

/// Intentos fallidos de login por ip + correo (guardados como hash), compartidos por todas las instancias de la API.
model LoginAttempt {
  keyHash      String    @id
  count        Int       @default(0)
  windowStart  DateTime
  blockedUntil DateTime?
  updatedAt    DateTime

  @@index([updatedAt])
}

enum NotificationType {
  EVENT_TEAM_ADDED
  EVENT_CANCELLED
  EVENT_RESCHEDULED
  EVENT_REMINDER
  SETLIST_PARTICIPANT_ADDED
  SETLIST_ASSIGNMENT_ADDED
  SETLIST_PUBLISHED
  INVITATION_RECEIVED
}

/// Aviso dentro de la app para una persona. dedupeKey (unico por persona) hace idempotente cada aviso: aunque varias
/// instancias de la API intenten crearlo (p. ej. un recordatorio), queda uno solo.
model Notification {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  type           NotificationType
  title          String
  body           String?
  link           String?
  dedupeKey      String
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, organizationId, createdAt])
}

/// Token para renovar la sesion. Solo se guarda su hash; rota en cada uso y todos los de un mismo login comparten familyId.
/// Fechas en que la persona no puede tocar (en todas sus organizaciones). La nota es privada: nadie mas la ve.
model Unavailability {
  id        String   @id @default(cuid())
  userId    String
  /// Dias de calendario, ambos incluidos.
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endsOn])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  familyId     String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// Lo que la persona sabe tocar (lo edita ella misma en "Mi perfil"). Lo que toca en cada setlist/evento va en sus asignaciones.
model UserInstrument {
  id         String             @id @default(cuid())
  userId     String
  instrument SetlistMusicalRole
  isPrimary  Boolean            @default(false)
  createdAt  DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, instrument])
  @@index([userId])
}

model Organization {
  id           String           @id @default(cuid())
  slug         String           @unique
  name         String
  type         OrganizationType @default(BAND)
  description  String?
  primaryColor String           @default("#18e0ae")
  /// Archivada: queda de solo lectura para todos (nada se borra); un propietario puede restaurarla.
  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?            @relation("OrganizationArchiver", fields: [archivedById], references: [id], onDelete: SetNull)
  activeForUsers User[]          @relation("UserActiveOrganization")
  notifications  Notification[]
  memberships  Membership[]
  invitations  Invitation[]
  songs        Song[]
  songNotes    SongNote[]
  songCommentThreads SongCommentThread[]
  songActivities SongActivity[]
  songVersionRevisions SongVersionRevision[]
  events       Event[]
  setlists     Setlist[]
  files        File[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([slug])
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole   @default(MUSICIAN)
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventMusicians EventMusician[]
  setlistParticipations SetlistParticipant[]

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@index([userId])
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           MembershipRole   @default(MUSICIAN)
  status         InvitationStatus @default(PENDING)
  token          String           @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User?            @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, email, status])
  @@index([email])
  @@index([organizationId])
}

model Song {
  id             String        @id @default(cuid())
  organizationId String
  title          String
  artist         String
  originalKey    String
  currentKey     String
  bpm            Int?
  durationSec    Int?
  album          String?
  year           Int?
  genre          String?
  timeSignature  String?
  language       String?
  isFavorite     Boolean       @default(false)
  coverUrl       String?
  youtubeUrl     String?
  lyrics         String?
  chords         String?
  notes          String?
  tags           String[]      @default([])
  status         SongStatus    @default(ACTIVE)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  setlistItems   SetlistItem[]
  files          File[]
  tracks         SongTrack[]
  versions       SongVersion[]
  links          SongLink[]
  songFiles      SongFile[]
  songNotes      SongNote[]
  commentThreads SongCommentThread[]
  activities     SongActivity[]
  revisions      SongVersionRevision[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, title])
}

model SongVersion {
  id            String       @id @default(cuid())
  songId        String
  name          String
  key           String
  bpm           Int?
  durationSec   Int?
  lyrics        String?
  chords        String?
  contentJson   Json?
  structureJson Json?
  notes         String?
  isDefault     Boolean      @default(false)
  song          Song         @relation(fields: [songId], references: [id], onDelete: Cascade)
  tracks        SongTrack[]
  links         SongLink[]
  songFiles     SongFile[]
  songNotes     SongNote[]
  commentThreads SongCommentThread[]
  activities    SongActivity[]
  revisions     SongVersionRevision[]
  setlistItems  SetlistItem[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([songId])
  @@index([songId, isDefault])
  @@index([songId, name])
}

model SongTrack {
  id            String        @id @default(cuid())
  songId        String
  versionId     String?
  uploadedById  String?
  name          String
  type          SongTrackType @default(OTHER)
  instrument    String?
  mimeType      String?
  sizeBytes     Int?
  durationSec   Int?
  originalFileName String?
  storageKey    String?
  url           String?
  provider      TrackProvider @default(UPLOAD)
  volumeDefault Float         @default(1)
  panDefault    Float         @default(0)
  isPrimary     Boolean       @default(false)
  sortOrder     Int           @default(0)
  active        Boolean       @default(true)
  song          Song          @relation(fields: [songId], references: [id], onDelete: Cascade)
  version       SongVersion?  @relation(fields: [versionId], references: [id], onDelete: SetNull)
  uploadedBy    User?         @relation("TrackUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([songId, sortOrder])
  @@index([versionId, sortOrder])
  @@index([songId, type])
  @@index([songId, isPrimary])
}

model SongLink {
  id           String           @id @default(cuid())
  songId       String
  versionId    String?
  createdById  String?
  provider     SongLinkProvider @default(OTHER)
  url          String
  title        String?
  externalId   String?
  thumbnailUrl String?
  embedUrl     String?
  isPrimary    Boolean          @default(false)
  sortOrder    Int              @default(0)
  active       Boolean          @default(true)
  song         Song             @relation(fields: [songId], references: [id], onDelete: Cascade)
  version      SongVersion?     @relation(fields: [versionId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation("SongLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([songId, sortOrder])
  @@index([versionId, sortOrder])
  @@index([songId, provider])
  @@index([songId, isPrimary])
}

model SongFile {
  id          String           @id @default(cuid())
  songId      String
  versionId   String?
  fileId      String
  category    SongFileCategory @default(OTHER)
  title       String?
  description String?
  isPrimary   Boolean          @default(false)
  sortOrder   Int              @default(0)
  active      Boolean          @default(true)
  song        Song             @relation(fields: [songId], references: [id], onDelete: Cascade)
  version     SongVersion?     @relation(fields: [versionId], references: [id], onDelete: SetNull)
  file        File             @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([songId, fileId])
  @@index([songId, sortOrder])
  @@index([versionId, sortOrder])
  @@index([songId, category])
  @@index([songId, isPrimary])
  @@index([fileId])
}

model SongNote {
  id             String             @id @default(cuid())
  songId         String
  versionId      String?
  organizationId String
  authorId       String

  title          String?
  content        String
  visibility     SongNoteVisibility @default(ORGANIZATION)

  isPinned       Boolean            @default(false)
  isArchived     Boolean            @default(false)

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  song           Song               @relation(fields: [songId], references: [id], onDelete: Cascade)
  version        SongVersion?       @relation(fields: [versionId], references: [id], onDelete: SetNull)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author         User               @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([songId, createdAt])
  @@index([versionId, createdAt])
  @@index([organizationId, visibility])
  @@index([authorId, createdAt])
  @@index([songId, isPinned])
}

model SongCommentThread {
  id             String              @id @default(cuid())
  songId         String
  versionId      String?
  organizationId String
  createdById    String

  targetType     SongCommentTarget   @default(SONG)
  targetRef      String?
  title          String?

  status         SongThreadStatus    @default(OPEN)
  resolvedAt     DateTime?
  resolvedById   String?

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  song           Song                @relation(fields: [songId], references: [id], onDelete: Cascade)
  version        SongVersion?        @relation(fields: [versionId], references: [id], onDelete: SetNull)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User                @relation("SongThreadCreator", fields: [createdById], references: [id], onDelete: Cascade)
  resolvedBy     User?               @relation("SongThreadResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  comments       SongComment[]

  @@index([songId, status, createdAt])
  @@index([versionId, status])
  @@index([organizationId, status])
}

model SongComment {
  id          String               @id @default(cuid())
  threadId    String
  authorId    String

  content     String
  editedAt    DateTime?
  deletedAt   DateTime?

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  thread      SongCommentThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author      User                 @relation("SongCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  mentions    SongCommentMention[]

  @@index([threadId, createdAt])
  @@index([authorId, createdAt])
}

model SongCommentMention {
  id         String      @id @default(cuid())
  commentId  String
  userId     String

  createdAt  DateTime    @default(now())

  comment    SongComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user       User        @relation("SongCommentMentioned", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId, createdAt])
}

model SongActivity {
  id             String           @id @default(cuid())
  songId         String
  versionId      String?
  organizationId String
  actorId        String?

  action         SongActivityType
  entityType     SongEntityType
  entityId       String?

  summary        String
  metadata       Json?

  createdAt      DateTime         @default(now())

  song           Song             @relation(fields: [songId], references: [id], onDelete: Cascade)
  version        SongVersion?     @relation(fields: [versionId], references: [id], onDelete: SetNull)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([songId, createdAt])
  @@index([versionId, createdAt])
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model SongVersionRevision {
  id             String         @id @default(cuid())
  songId         String
  versionId      String
  organizationId String
  createdById    String?

  revisionNumber Int
  reason         String?
  source         RevisionSource

  name           String
  key            String?
  bpm            Int?
  durationSec    Int?
  contentJson    Json?
  structureJson  Json?
  lyrics         String?
  chords         String?
  notes          String?
  contentHash    String

  createdAt      DateTime       @default(now())

  song           Song           @relation(fields: [songId], references: [id], onDelete: Cascade)
  version        SongVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([versionId, revisionNumber])
  @@index([songId, createdAt])
  @@index([versionId, revisionNumber])
  @@index([versionId, contentHash])
  @@index([organizationId, createdAt])
}

model Event {
  id             String          @id @default(cuid())
  organizationId String
  setlistId      String?
  name           String
  startsAt       DateTime
  endsAt         DateTime?
  location       String?
  description    String?
  status         EventStatus     @default(DRAFT)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  setlist        Setlist?        @relation(fields: [setlistId], references: [id], onDelete: SetNull)
  musicians      EventMusician[]
  files          File[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, startsAt])
  @@index([organizationId, status])
}

model EventMusician {
  id           String           @id @default(cuid())
  eventId      String
  membershipId String
  instrument   String?
  status       AttendanceStatus @default(PENDING)
  note         String?
  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  membership   Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([eventId, membershipId])
  @@index([membershipId])
}

enum SetlistStatus {
  DRAFT
  READY
  PUBLISHED
  ARCHIVED
}

enum SetlistItemType {
  SONG
  SPEAKING
  PRAYER
  VIDEO
  ANNOUNCEMENT
  SILENCE
  TRANSITION
  BREAK
  CUSTOM
}

model Setlist {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         SetlistStatus @default(DRAFT)
  estimatedSec   Int           @default(0)
  itemCount      Int           @default(0)
  isTemplate     Boolean       @default(false)
  createdById    String?
  updatedById    String?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?         @relation("SetlistCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?         @relation("SetlistUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  items          SetlistItem[]
  events         Event[]
  files          File[]
  participants   SetlistParticipant[]
  cues           SetlistCue[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, name])
  @@index([organizationId, updatedAt])
}

model SetlistItem {
  id                  String          @id @default(cuid())
  setlistId           String
  type                SetlistItemType @default(SONG)
  songId              String?
  songVersionId       String?
  title               String
  description         String?
  order               Int
  estimatedSec        Int?
  keyOverride         String?
  bpmOverride         Int?
  durationOverrideSec Int?
  capo                Int?
  transitionNote      String?
  internalNote        String?
  includeClick        Boolean         @default(false)
  includePad          Boolean         @default(false)
  isOptional          Boolean         @default(false)
  isHidden            Boolean         @default(false)
  setlist             Setlist         @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  song                Song?           @relation(fields: [songId], references: [id], onDelete: SetNull)
  songVersion         SongVersion?    @relation(fields: [songVersionId], references: [id], onDelete: Restrict)
  assignments         SetlistAssignment[]
  roleRequirements    SetlistRoleRequirement[]
  cues                SetlistCue[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([setlistId, order])
  @@index([setlistId, type])
  @@index([songId])
  @@index([songVersionId])
}

enum SetlistParticipantStatus {
  INVITED
  CONFIRMED
  DECLINED
  TENTATIVE
  NOT_REQUIRED
}

enum SetlistMusicalRole {
  MUSIC_DIRECTOR
  BAND_LEADER
  LEAD_VOCAL
  BACKING_VOCAL
  CHOIR

  ACOUSTIC_GUITAR
  ELECTRIC_GUITAR
  BASS
  DRUMS
  PERCUSSION
  PIANO
  KEYS
  ORGAN
  SYNTH
  STRINGS
  BRASS
  WOODWIND
  VIOLIN
  CELLO

  TRACKS
  CLICK
  PAD

  AUDIO_ENGINEER
  MONITOR_ENGINEER
  LIGHTING
  VIDEO

  SPEAKER
  PRAYER_LEADER
  ANNOUNCER

  OTHER
}

enum AssignmentPreparationStatus {
  PENDING
  IN_PROGRESS
  READY
  NEEDS_REVIEW
  BLOCKED
  NOT_APPLICABLE
}

model SetlistParticipant {
  id           String                   @id @default(cuid())
  setlistId    String
  membershipId String

  status       SetlistParticipantStatus @default(INVITED)
  generalRole  String?
  generalNote  String?

  addedById    String?
  respondedAt  DateTime?

  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  setlist      Setlist                  @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  membership   Membership               @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  addedBy      User?                    @relation("SetlistParticipantAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  assignments  SetlistAssignment[]
  responsibleCues SetlistCue[]     @relation("SetlistCueResponsibleParticipant")

  @@unique([setlistId, membershipId])
  @@index([setlistId, status])
  @@index([membershipId])
}

model SetlistAssignment {
  id                String                       @id @default(cuid())
  setlistItemId     String
  participantId     String

  role              SetlistMusicalRole
  instrument        String?
  label             String?

  isPrimary         Boolean                      @default(false)
  isRequired        Boolean                      @default(true)

  preparationStatus AssignmentPreparationStatus  @default(PENDING)
  preparationNote   String?

  sortOrder         Int                          @default(0)

  createdById       String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  setlistItem       SetlistItem                  @relation(fields: [setlistItemId], references: [id], onDelete: Cascade)
  participant       SetlistParticipant           @relation(fields: [participantId], references: [id], onDelete: Cascade)
  createdBy         User?                        @relation("SetlistAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  responsibleCues   SetlistCue[]                 @relation("SetlistCueResponsibleAssignment")

  @@unique([setlistItemId, participantId, role])
  @@index([setlistItemId, role])
  @@index([participantId])
  @@index([setlistItemId, preparationStatus])
}

model SetlistRoleRequirement {
  id            String             @id @default(cuid())
  setlistItemId String
  role          SetlistMusicalRole
  label         String?
  minimumCount  Int                @default(1)
  isRequired    Boolean            @default(true)

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  setlistItem   SetlistItem        @relation(fields: [setlistItemId], references: [id], onDelete: Cascade)

  @@unique([setlistItemId, role])
  @@index([setlistItemId, isRequired])
}

enum SetlistCueType {
  COUNT_IN
  CLICK_START
  CLICK_STOP
  PAD_START
  PAD_STOP
  TRACK_START
  TRACK_STOP

  MUSIC_ENTRY
  MUSIC_STOP
  DYNAMICS_UP
  DYNAMICS_DOWN
  REPEAT_SECTION
  SKIP_SECTION
  MODULATION
  TEMPO_CHANGE
  FREE_TIME
  HOLD
  ENDING

  SPEAKING
  PRAYER
  ANNOUNCEMENT
  SILENCE

  VIDEO_START
  VIDEO_STOP
  SLIDE_CHANGE
  LYRICS_ON
  LYRICS_OFF

  LIGHTS_SCENE
  LIGHTS_BLACKOUT
  LIGHTS_FADE

  AUDIO_MUTE
  AUDIO_UNMUTE
  AUDIO_LEVEL
  MONITOR_CHANGE

  INSTRUMENT_CHANGE
  CAPO_CHANGE
  PATCH_CHANGE
  TUNING_CHANGE

  ENTER_STAGE
  EXIT_STAGE
  POSITION_CHANGE

  TIMER
  MARKER
  CUSTOM
}

enum SetlistCuePhase {
  BEFORE
  DURING
  AFTER
  GLOBAL
}

enum SetlistCueStatus {
  PENDING
  READY
  NEEDS_REVIEW
  BLOCKED
  COMPLETED
  SKIPPED
}

enum SetlistCuePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model SetlistCue {
  id                       String             @id @default(cuid())
  setlistId                String
  setlistItemId            String?

  type                     SetlistCueType
  phase                    SetlistCuePhase    @default(BEFORE)
  status                   SetlistCueStatus   @default(PENDING)
  priority                 SetlistCuePriority @default(NORMAL)

  title                    String
  description              String?

  offsetSec                Int?
  durationSec              Int?
  sortOrder                Int                @default(0)

  metadata                 Json?

  isOptional               Boolean            @default(false)
  isHidden                 Boolean            @default(false)

  responsibleParticipantId String?
  responsibleAssignmentId  String?

  createdById              String?
  completedById            String?
  completedAt              DateTime?

  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  setlist                 Setlist             @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  setlistItem             SetlistItem?        @relation(fields: [setlistItemId], references: [id], onDelete: Cascade)
  responsibleParticipant  SetlistParticipant? @relation("SetlistCueResponsibleParticipant", fields: [responsibleParticipantId], references: [id], onDelete: SetNull)
  responsibleAssignment   SetlistAssignment?  @relation("SetlistCueResponsibleAssignment", fields: [responsibleAssignmentId], references: [id], onDelete: SetNull)
  createdBy               User?               @relation("SetlistCueCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  completedBy             User?               @relation("SetlistCueCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([setlistId, sortOrder])
  @@index([setlistItemId, phase, sortOrder])
  @@index([setlistId, type])
  @@index([setlistId, status])
  @@index([responsibleParticipantId])
  @@index([responsibleAssignmentId])
}

model File {
  id             String       @id @default(cuid())
  organizationId String
  uploadedById   String?
  songId         String?
  eventId        String?
  setlistId      String?
  name           String
  originalName   String?
  type           FileType
  mimeType       String?
  sizeBytes      Int?
  storageKey     String?
  url            String?
  checksum       String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy     User?        @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  song           Song?        @relation(fields: [songId], references: [id], onDelete: SetNull)
  songFiles      SongFile[]
  event          Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  setlist        Setlist?     @relation(fields: [setlistId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, type])
  @@index([songId])
  @@index([eventId])
  @@index([setlistId])
}
