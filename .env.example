DATABASE_URL="postgresql://postgres:admin@localhost:5432/harmonyhub"
JWT_SECRET="harmonyhub-local-dev-secret"
JWT_TTL_SECONDS="28800"
MAX_TRACK_UPLOAD_MB="100"
MAX_SONG_FILE_UPLOAD_MB="25"

# --- Almacenamiento de pistas ---
# Proveedor de storage para pistas subidas: "local" (por defecto), "s3", "r2" o "supabase".
# Si se elige un driver S3 pero faltan credenciales, se usa "local" como fallback.
TRACK_STORAGE_DRIVER="local"

# Proveedor local (fallback). Ruta relativa a la raiz del proyecto o absoluta.
TRACK_STORAGE_LOCAL_ROOT="var/tracks"

# Proveedor S3-compatible (AWS S3 / Cloudflare R2 / Supabase Storage).
# Requiere instalar la dependencia "@aws-sdk/client-s3" cuando se active.
S3_BUCKET=""
S3_REGION=""
# Endpoint personalizado para R2/Supabase/MinIO. Dejar vacio para AWS S3.
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# "true" para R2/Supabase/MinIO (path-style). Por defecto true si hay S3_ENDPOINT.
S3_FORCE_PATH_STYLE=""
# Prefijo opcional dentro del bucket (p.ej. "tracks").
S3_PREFIX=""
